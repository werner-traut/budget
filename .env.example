# Auth
AUTH_URL=http://localhost:3000
AUTH_SECRET="" # Generate with: openssl rand -base64 32

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database Configuration
# For local development: Use direct PostgreSQL connection (Docker Compose)
DATABASE_URL="postgresql://admin:admin@localhost:5432/budget"
DIRECT_URL="postgresql://admin:admin@localhost:5432/budget"

# For production (Vercel): Use Prisma Accelerate
# DATABASE_URL="prisma://accelerate.prisma-data.net/?api_key=YOUR_API_KEY"
# DIRECT_URL="postgresql://user:password@host:port/database"

# Optional: Enable Prisma query logging
# DEBUG=prisma:query

# Local-only auth bypass. Adds a "Dev sign in" button that logs in as a fixed
# dev user without Google OAuth. Ignored entirely in production builds.
# Both vars are required: the first enables the server provider, the second
# (NEXT_PUBLIC_) reveals the button in the client.
# DEV_AUTH_BYPASS=true
# NEXT_PUBLIC_DEV_AUTH_BYPASS=true
